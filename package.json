{
  "name": "google-search-console-updater",
  "version": "2.0.3",
  "description": "Portable app for Google Search Console URL inspection, indexing, and AI site audit",
  "main": "electron/main.cjs",
  "author": "Marfa",
  "license": "CC-BY-NC-SA-4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Marfa/Google_Search_Console_Index_Updater.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac zip",
    "build:mac": "electron-builder --mac zip",
    "build:win": "node scripts/build-win.mjs",
    "package:win": "node scripts/package-win-release.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "build:publish": "electron-builder --mac zip --publish always",
    "audit": "npm audit",
    "outdated": "npx npm-check-updates",
    "check:audit-helpers": "node scripts/check-audit-helpers.cjs",
    "check:errors": "node scripts/check-errors.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "google-auth-library": "11.3.3"
  },
  "devDependencies": {
    "archiver": "^8.0.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "pe-library": "^2.0.1",
    "png-to-ico": "^3.0.2",
    "resedit": "3.1.0",
    "sharp": "0.35.5"
  },
  "overrides": {
    "undici@^6": "6.29.1",
    "undici@^7": "7.30.1",
    "fast-uri": "3.1.9",
    "js-yaml": "4.3.2",
    "@xmldom/xmldom": "0.8.15",
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^2": "2.1.7",
    "brace-expansion@^5": "5.0.12",
    "minimatch": "11.0.4"
  },
  "build": {
    "appId": "com.marfa.gsc-updater",
    "productName": "Google Search Console Updater",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "electronLanguages": [
      "en",
      "ru"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "afterSign": "scripts/after-sign.cjs",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "build/icon.png",
      "build/icon.ico",
      "config.example.json",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Marfa",
        "repo": "Google_Search_Console_Index_Updater"
      }
    ],
    "mac": {
      "identity": "-",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "Google-Search-Console-Updater-${version}-mac-arm64.${ext}",
      "category": "public.app-category.utilities"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Google-Search-Console-Updater-${version}-win-x64.${ext}"
    }
  }
}
